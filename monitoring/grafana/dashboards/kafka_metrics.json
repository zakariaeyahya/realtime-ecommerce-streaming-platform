{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Kafka Broker Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "description": "Kafka broker availability (requires JMX exporter)",
      "targets": [
        {
          "expr": "up{job=\"kafka\"}",
          "legendFormat": "Broker"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "noValue": "N/A (JMX not configured)"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Messages In per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total[5m])",
          "legendFormat": "Messages/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "noValue": "N/A" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Bytes In / Out",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_bytesin_total[5m])",
          "legendFormat": "Bytes In"
        },
        {
          "expr": "rate(kafka_server_brokertopicmetrics_bytesout_total[5m])",
          "legendFormat": "Bytes Out"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "noValue": "N/A" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Consumer Group Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_consumer_group_lag",
          "legendFormat": "{{group}} - {{topic}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "N/A" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Active Partitions",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_server_replicamanager_partitioncount",
          "legendFormat": "Partitions"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "N/A" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Under-Replicated Partitions",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kafka_server_replicamanager_underreplicatedpartitions",
          "legendFormat": "Under-replicated"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Info",
      "type": "text",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "options": {
        "mode": "markdown",
        "content": "**Note:** Kafka metrics require JMX Exporter to be configured on the Kafka broker. If panels show N/A, add JMX Exporter to Kafka in docker-compose.yml."
      }
    }
  ],
  "schemaVersion": 38,
  "tags": ["kafka", "messaging"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Kafka Metrics",
  "uid": "kafka-metrics",
  "version": 1
}
