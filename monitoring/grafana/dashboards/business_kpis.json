{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(up == 1)",
          "legendFormat": "Services UP"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 2 }, { "color": "green", "value": 3 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Fraud Requests / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(api_requests_total{endpoint=\"fraud\"}[5m])) * 60",
          "legendFormat": "Fraud req/min"
        },
        {
          "expr": "sum(rate(api_requests_total{endpoint=\"recommendations\"}[5m])) * 60",
          "legendFormat": "Reco req/min"
        },
        {
          "expr": "sum(rate(api_requests_total{endpoint=\"inventory\"}[5m])) * 60",
          "legendFormat": "Inventory req/min"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "API Error Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(api_requests_total{status=\"404\"}[5m])) / sum(rate(api_requests_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.3 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Redis Cache Keys",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(redis_db_keys)",
          "legendFormat": "Total Keys"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Fraud Detection - Success vs Miss",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(api_requests_total{endpoint=\"fraud\",status=\"200\"})",
          "legendFormat": "Found (200)"
        },
        {
          "expr": "sum(api_requests_total{endpoint=\"fraud\",status=\"404\"})",
          "legendFormat": "Not Found (404)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recommendations - Success vs Miss",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(api_requests_total{endpoint=\"recommendations\",status=\"200\"})",
          "legendFormat": "Found (200)"
        },
        {
          "expr": "sum(api_requests_total{endpoint=\"recommendations\",status=\"404\"})",
          "legendFormat": "Not Found (404)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Inventory - Success vs Miss",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(api_requests_total{endpoint=\"inventory\",status=\"200\"})",
          "legendFormat": "Found (200)"
        },
        {
          "expr": "sum(api_requests_total{endpoint=\"inventory\",status=\"404\"})",
          "legendFormat": "Not Found (404)"
        }
      ]
    },
    {
      "id": 8,
      "title": "Average Response Latency by Endpoint",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Redis Memory vs Max",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Used (MB)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Services Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ],
  "schemaVersion": 38,
  "tags": ["business", "kpis", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Business KPIs Overview",
  "uid": "business-kpis",
  "version": 1
}
